@PACKAGE_INIT@

set(QT_NO_PRIVATE_MODULE_WARNING ON)

find_dependency(Qt6 6.8 REQUIRED
    COMPONENTS Core Quick QuickControls2 Gui QuickTemplates2 QuickLayouts QuickEffects
        QuickControls2Basic QuickControls2Material QuickControls2Fusion QuickControls2Universal
        Qml QmlCore QmlModels
    OPTIONAL_COMPONENTS GuiPrivate QuickPrivate QuickTemplates2Private QmlPrivate QmlModelsPrivate)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

set(CARBOXYL_STYLES @CARBOXYL_STYLES@)

include(CarboxylCloverTargets)
include(CarboxylBaseTargets)
include(CarboxylContourTargets)

foreach(style @CARBOXYL_STYLES@)
    include(Carboxyl${style}Targets)
endforeach()

include(CarboxylTargets)
